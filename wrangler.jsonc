{
  "name": "kreatify",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./" },
  "vars": { "AI_MODEL": "openai/gpt-oss-120b", "FREE_DAILY_LIMIT": "5" },
  "d1_databases": [
    { "binding": "DB", "database_name": "kreatify", "database_id": "8f9b1141-0acc-4891-aa00-e354b464565b" }
  ],
  "ratelimits": [
    { "name": "IP_LIMITER", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 40, "period": 60 } }
  ]
}
